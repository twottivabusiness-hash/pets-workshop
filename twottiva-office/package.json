{
  "name": "twottiva-office",
  "private": true,
  "version": "0.1.0",
  "description": "TWOTTIVA AI Office — TASK 기반 오피스 상태 엔진",
  "type": "module",
  "scripts": {
    "test": "tsx test/acceptance.ts && tsx test/targets.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/office/runtime.ts --bundle --format=iife --global-name=TwottivaOffice --outfile=dist/twottiva-office-engine.js --target=es2019 --footer:js='if(typeof window!==\"undefined\"){window.TwottivaOffice=TwottivaOffice;}'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}